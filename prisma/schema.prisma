generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model TimeSlot {
  id         String   @id @default(uuid())
  date       String
  startTime  String
  duration   Int
  isBooked   Boolean  @default(false)
  guestName  String?
  guestEmail String?
  createdAt  DateTime @default(now())

  @@map("time_slots")
}
